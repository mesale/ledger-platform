# EditorConfig: https://editorconfig.org
# This is the root config file — stop looking further up the tree.
root = true

# ---------- Defaults for everything ----------
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# ---------- C# / .NET ----------
[*.cs]
indent_size = 4

# Namespace & organization
csharp_style_namespace_declarations = file_scoped:error
csharp_using_directive_placement = outside_namespace:error
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# var usage — prefer var when the type is obvious, otherwise explicit
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Expression-bodied members
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_constructors = false:suggestion

# Pattern matching & modern C#
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion

# Null-checking style
csharp_style_conditional_delegate_call = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion

# Braces & newlines (Allman style — braces on their own line)
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_prefer_braces = true:error

# Modifiers
dotnet_style_require_accessibility_modifiers = always:error
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:suggestion
dotnet_style_readonly_field = true:suggestion

# Naming conventions ---------------------------------------------------

# Interfaces start with I
dotnet_naming_rule.interfaces_start_with_i.severity = error
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbol
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i_style
dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_style.prefix_i_style.required_prefix = I
dotnet_naming_style.prefix_i_style.capitalization = pascal_case

# Types (classes, structs, enums, records) — PascalCase
dotnet_naming_rule.types_pascal_case.severity = error
dotnet_naming_rule.types_pascal_case.symbols = type_symbol
dotnet_naming_rule.types_pascal_case.style = pascal_case_style
dotnet_naming_symbols.type_symbol.applicable_kinds = class,struct,enum,record
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# Methods, properties, events — PascalCase
dotnet_naming_rule.members_pascal_case.severity = error
dotnet_naming_rule.members_pascal_case.symbols = member_symbol
dotnet_naming_rule.members_pascal_case.style = pascal_case_style
dotnet_naming_symbols.member_symbol.applicable_kinds = method,property,event

# Private fields — _camelCase
dotnet_naming_rule.private_fields_underscore_camel.severity = error
dotnet_naming_rule.private_fields_underscore_camel.symbols = private_field_symbol
dotnet_naming_rule.private_fields_underscore_camel.style = underscore_camel_case_style
dotnet_naming_symbols.private_field_symbol.applicable_kinds = field
dotnet_naming_symbols.private_field_symbol.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case_style.required_prefix = _
dotnet_naming_style.underscore_camel_case_style.capitalization = camel_case

# Constants — PascalCase
dotnet_naming_rule.constants_pascal_case.severity = error
dotnet_naming_rule.constants_pascal_case.symbols = constant_symbol
dotnet_naming_rule.constants_pascal_case.style = pascal_case_style
dotnet_naming_symbols.constant_symbol.applicable_kinds = field,local
dotnet_naming_symbols.constant_symbol.required_modifiers = const

# Parameters & locals — camelCase
dotnet_naming_rule.parameters_camel_case.severity = suggestion
dotnet_naming_rule.parameters_camel_case.symbols = parameter_symbol
dotnet_naming_rule.parameters_camel_case.style = camel_case_style
dotnet_naming_symbols.parameter_symbol.applicable_kinds = parameter,local
dotnet_naming_style.camel_case_style.capitalization = camel_case

# ---------- Project files ----------
[*.{csproj,props,targets}]
indent_size = 2

# ---------- JSON / config ----------
[*.json]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

# ---------- Frontend (React/TypeScript) ----------
[*.{ts,tsx,js,jsx}]
indent_size = 2
quote_type = single

[*.{css,scss}]
indent_size = 2

[*.html]
indent_size = 2

# ---------- Markdown ----------
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# ---------- Shell / Docker ----------
[*.sh]
end_of_line = lf
indent_size = 2

[Dockerfile]
indent_size = 4